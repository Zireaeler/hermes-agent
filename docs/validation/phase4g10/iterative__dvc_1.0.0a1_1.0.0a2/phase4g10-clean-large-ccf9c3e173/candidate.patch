+                "shutil.copytree(sys.argv[1], sys.argv[2])\n"
+            ),
+        }
+    )
+    stage = dvc.run(
+        cmd="python copydir.py src out",
+        deps=["copydir.py", "src"],
+        outs=["out"],
+        name="copy-directory",
+    )
+    first_checksum = stage.outs[0].checksum
+
+    (tmp_dir / "src" / "data").write_text("second")
+    dvc.reproduce(stage.addressing)
+    stage = stage.reload()
+    second_checksum = stage.outs[0].checksum
+    assert first_checksum != second_checksum
+
+    dvc.push(run_cache=True)
+    remote = dvc.cloud.get_remote()
+    for checksum in [first_checksum, second_checksum]:
+        assert remote.exists(remote.checksum_to_path_info(checksum))
+        for entry in dvc.cache.local.get_dir_cache(checksum):
+            child = remote.checksum_to_path_info(entry[remote.PARAM_CHECKSUM])
+            assert remote.exists(child)
+
+    remove(dvc.cache.local.cache_dir)
+    dvc.fetch(run_cache=True)
+    for checksum in [first_checksum, second_checksum]:
+        checksum_info = dvc.cache.local.checksum_to_path_info(checksum)
+        assert dvc.cache.local.exists(checksum_info)
+        for entry in dvc.cache.local.get_dir_cache(checksum):
+            child = dvc.cache.local.checksum_to_path_info(
+                entry[dvc.cache.local.PARAM_CHECKSUM]
+            )
+            assert dvc.cache.local.exists(child)
+
