@@ -0,0 +1,53 @@
+"""Repository plots API."""
+
+from dvc.repo.plot import (  # noqa: F401
+    DIV_HTML,
+    PAGE_HTML,
+    NoDataOrTemplateProvided,
+    TooManyDataSourcesError,
+    _collect_plots,
+    _evaluate_templatepath,
+    _infer_y_field,
+    _parse_template,
+    fill_template,
+)
+
+
+class Plots:
+    def __init__(self, repo):
+        self.repo = repo
+
+    def show(self, *args, **kwargs):
+        from dvc.repo.plots.show import show
+
+        return show(self.repo, *args, **kwargs)
+
+    def diff(self, *args, **kwargs):
+        from dvc.repo.plots.diff import diff
+
+        return diff(self.repo, *args, **kwargs)
+
+    @property
+    def templates(self):
+        return self.repo.plot_templates
+
+    def __call__(self, datafile=None, template=None, **kwargs):
+        """Compatibility with the short-lived callable ``Repo.plots`` API."""
+        if datafile is not None:
+            kwargs.setdefault("targets", datafile)
+        if template is not None:
+            kwargs.setdefault("template", template)
+        plots = self.show(**kwargs)
+        if len(plots) == 1:
+            return next(iter(plots.values()))
+        return "[\n{}\n]".format(",\n".join(plots.values()))
+
+
+__all__ = [
+    "DIV_HTML",
+    "PAGE_HTML",
+    "NoDataOrTemplateProvided",
+    "Plots",
+    "TooManyDataSourcesError",
+    "fill_template",
+]
