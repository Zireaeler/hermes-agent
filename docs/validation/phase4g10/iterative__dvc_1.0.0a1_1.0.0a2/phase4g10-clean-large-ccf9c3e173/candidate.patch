@@ -0,0 +1,39 @@
+"""Generate plot specifications across Git revisions."""
+
+from dvc.repo.plot.data import WORKSPACE_REVISION_NAME
+
+
+def _revisions(revisions, is_dirty):
+    """Return explicit revisions or the default HEAD/workspace comparison."""
+    revisions = list(revisions or [])
+    if len(revisions) <= 1:
+        if len(revisions) == 0 and is_dirty:
+            revisions.append("HEAD")
+        revisions.append(WORKSPACE_REVISION_NAME)
+    return revisions
+
+
+def diff(
+    repo,
+    targets=None,
+    revs=None,
+    props=None,
+    revisions=None,
+    datafile=None,
+    **kwargs
+):
+    from dvc.repo.plots.show import show
+
+    if revs is None:
+        revs = revisions
+    return show(
+        repo,
+        targets=targets,
+        datafile=datafile,
+        revs=_revisions(revs, repo.scm.is_dirty()),
+        props=props,
+        **kwargs
+    )
+
+
+__all__ = ["_revisions", "diff"]
diff --git a/dvc/repo/plots/show.py b/dvc/repo/plots/show.py
new file mode 100644
index 0000000..f2e3ffb
--- /dev/null
+++ b/dvc/repo/plots/show.py
@@ -0,0 +1,70 @@
+"""Generate plot specifications for repository data."""
+
+from dvc.repo.plot import _collect_plots, fill_template
+from dvc.repo.plot import plot as _plot
+
+
+def _targets(targets):
+    if targets is None:
+        return None
+    if isinstance(targets, str):
+        return [targets]
+    return list(targets)
+
+
+def show(
+    repo,
+    targets=None,
+    revs=None,
+    props=None,
+    template=None,
+    revisions=None,
+    datafile=None,
+    **kwargs
+):
+    """Generate one plot specification per target.
+
+    Plot markers make the default target set discoverable from DVC files. The
+    mapping return value preserves the association between each target and its
+    rendered specification, which is required for multi-plot CLI output.
+
+    ``datafile`` and ``revisions`` remain accepted as compatibility aliases
+    for the pre-plural plots API.
+    """
+    if props:
+        merged = dict(props)
+        merged.update(kwargs)
+        kwargs = merged
+
+    prop_template = kwargs.pop("template", None)
+    if template is None:
+        template = prop_template
+
+    if revisions is None:
+        revisions = revs
+
+    normalized = _targets(targets)
+    if normalized is None and datafile is not None:
+        normalized = [datafile]
+    if not normalized:
+        normalized = _collect_plots(repo)
+
+    # A template can contain its own data anchor. Keep a single target-less
+    # render in that case so template validation raises its specific error.
+    if not normalized and template:
+        normalized = [None]
+
+    plots = {}
+    for target in normalized or [None]:
+        content = _plot(
+            repo,
+            datafile=target,
+            template=template,
+            revisions=revisions,
+            **kwargs
+        )
+        plots[target or template or "plot"] = content
+    return plots
+
+
+__all__ = ["fill_template", "show"]
