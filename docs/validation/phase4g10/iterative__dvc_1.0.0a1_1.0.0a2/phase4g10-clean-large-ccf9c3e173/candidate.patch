+def copy_fobj_to_file(
+    fsrc, dest, no_progress_bar=False, name=None, total=None
+):
+    """Copy a readable file object into a local file.
+
+    Tree implementations such as ``GitTree`` expose in-memory file objects
+    rather than local source paths. Keeping the source as a stream lets those
+    objects use the same progress-aware copy path as regular files.
+    """
+    from dvc.progress import Tqdm
+
+    dest = fspath_py35(dest)
+    name = name or os.path.basename(dest)
+
+    if total is None:
+        try:
+            position = fsrc.tell()
+            fsrc.seek(0, os.SEEK_END)
+            total = fsrc.tell() - position
+            fsrc.seek(position)
+        except (AttributeError, IOError, OSError, ValueError):
+            total = None
+
+    with open(dest, "wb+") as fdest:
+        with Tqdm.wrapattr(
+            fdest,
+            "write",
+            desc=name,
+            disable=no_progress_bar,
+            total=total,
+            bytes=True,
+        ) as fdest_wrapped:
+            while True:
+                chunk = fsrc.read(LOCAL_CHUNK_SIZE)
+                if not chunk:
+                    break
+                if isinstance(chunk, str):
+                    chunk = chunk.encode()
+                fdest_wrapped.write(chunk)
+
+
