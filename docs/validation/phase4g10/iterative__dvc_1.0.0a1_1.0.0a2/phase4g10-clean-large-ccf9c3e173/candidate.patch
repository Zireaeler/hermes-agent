@@ -0,0 +1,30 @@
+"""Stage execution entry points."""
+
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def run_stage(stage, *args, **kwargs):
+    """Run ``stage`` with the standard :class:`Stage` execution contract."""
+    if kwargs.get("dry", False):
+        if stage.locked:
+            logger.info(
+                "Verifying outputs in locked {stage}".format(stage=stage)
+            )
+        elif stage.is_import:
+            logger.info(
+                "Importing '{dep}' -> '{out}'".format(
+                    dep=stage.deps[0], out=stage.outs[0]
+                )
+            )
+        elif stage.is_data_source:
+            logger.info("Verifying data sources in {}".format(stage))
+        else:
+            logger.info("Running command:\n\t{}".format(stage.cmd))
+        return None
+
+    return stage.run(*args, **kwargs)
+
+
+__all__ = ["run_stage"]
