+def test_run_cache_with_uncached_output(tmp_dir, dvc):
+    tmp_dir.gen(
+        {
+            "dep": "dep",
+            "copy-and-count.py": (
+                "import pathlib, shutil, sys\n"
+                "counter = pathlib.Path(sys.argv[3])\n"
+                "count = int(counter.read_text()) + 1 "
+                "if counter.exists() else 1\n"
+                "counter.write_text(str(count))\n"
+                "shutil.copyfile(sys.argv[1], sys.argv[2])\n"
+            ),
+        }
+    )
+    kwargs = {
+        "cmd": "python copy-and-count.py dep out counter",
+        "deps": ["dep", "copy-and-count.py"],
+        "outs_no_cache": ["out"],
+        "single_stage": True,
+    }
+
+    stage = dvc.run(**kwargs)
+    assert (tmp_dir / "counter").read_text() == "1"
+
+    os.unlink(stage.path)
+    dvc.run(**kwargs)
+
+    # The matching uncached output is already in the workspace, so the run
+    # cache can be used without executing the command again.
+    assert (tmp_dir / "counter").read_text() == "1"
+
+    os.unlink(stage.path)
+    os.unlink("out")
+    dvc.run(**kwargs)
+
+    # An uncached output cannot be restored; a missing one requires a rerun.
+    assert (tmp_dir / "counter").read_text() == "2"
+
+
+def test_fill_stage_outputs_with_inline_options(tmp_dir, dvc):
+    from dvc.stage import create_stage
+
+    stage = create_stage(
+        Stage,
+        dvc,
+        str(tmp_dir / "options.dvc"),
+        outs=[
+            "cached",
+            {"uncached": {"cache": False}},
+            {"persistent": {"persist": True}},
+        ],
+        metrics=[{"metric": {"cache": False}}],
+    )
+
+    outs = {out.def_path: out for out in stage.outs}
+    assert outs["cached"].use_cache
+    assert not outs["uncached"].use_cache
+    assert outs["persistent"].persist
+    assert outs["metric"].metric
+    assert not outs["metric"].use_cache
+
