+def test_update_recursive(tmp_dir, dvc, erepo_dir):
+    with erepo_dir.chdir():
+        erepo_dir.scm_gen(
+            {"one": "one", "two": "two"}, commit="add imported files"
+        )
+
+    imports = tmp_dir / "imports"
+    imports.mkdir()
+    dvc.imp(fspath(erepo_dir), "one", out=fspath(imports / "one"))
+    dvc.imp(fspath(erepo_dir), "two", out=fspath(imports / "two"))
+
+    with erepo_dir.chdir():
+        erepo_dir.scm_gen(
+            {"one": "updated one", "two": "updated two"},
+            commit="update imported files",
+        )
+
+    stages = dvc.update(fspath(imports), recursive=True)
+
+    assert len(stages) == 2
+    assert (imports / "one").read_text() == "updated one"
+    assert (imports / "two").read_text() == "updated two"
