+"""Repository namespace and public API for plots."""
+
+
+class Plots:
+    def __init__(self, repo):
+        self.repo = repo
+
+    def __call__(self, *args, **kwargs):
+        return self.show(*args, **kwargs)
+
+    def show(self, *args, **kwargs):
+        from dvc.repo.plots.show import show
+
+        return show(self.repo, *args, **kwargs)
+
+    def diff(self, *args, **kwargs):
+        from dvc.repo.plots.diff import diff
+
+        return diff(self.repo, *args, **kwargs)
+
+
+def plots(repo, *args, **kwargs):
+    """Generate plots using the plural repository-function name."""
+    from dvc.repo.plots.show import show
+
+    return show(repo, *args, **kwargs)
+
+
+from dvc.repo.plots.data import (  # noqa: E402,F401
+    NoMetricInHistoryError,
+    NoMetricOnRevisionError,
+    PlotDataStructureError,
+    PlotMetricTypeError,
+)
+from dvc.repo.plots.show import (  # noqa: E402,F401
+    DIV_HTML,
+    PAGE_HTML,
+    NoDataOrTemplateProvided,
+    TooManyDataSourcesError,
+    _evaluate_templatepath,
+    _infer_y_field,
+    _parse_template,
+    fill_template,
+    plot,
+)
+from dvc.repo.plots.template import (  # noqa: E402,F401
