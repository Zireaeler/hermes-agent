index 0000000..e9c83d9
--- /dev/null
+++ b/dvc/utils/networkx.py
@@ -0,0 +1,17 @@
+def get_networkx():
+    """Import DVC's supported legacy networkx on modern Python.
+
+    DVC 1.0 pins networkx below 2.4. Those releases import ``gcd`` from
+    :mod:`fractions`, where it was removed in Python 3.9. Keep this
+    compatibility adjustment local to graph code so the locked dependency
+    can be used without changing the environment.
+    """
+    import fractions
+    import math
+
+    if not hasattr(fractions, "gcd"):
+        fractions.gcd = math.gcd
+
+    import networkx
+
+    return networkx
