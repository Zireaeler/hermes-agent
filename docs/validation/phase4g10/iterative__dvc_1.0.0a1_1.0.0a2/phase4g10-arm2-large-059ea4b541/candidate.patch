+++ b/dvc/stage/run.py
@@ -0,0 +1,74 @@
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def run_stage(stage, dry=False, no_commit=False, force=False, run_cache=True):
+    if (stage.cmd or stage.is_import) and not stage.locked and not dry:
+        stage.remove_outs(ignore_remove=False, force=False)
+
+    if stage.locked:
+        logger.info(
+            "Verifying outputs in locked {stage}".format(stage=stage)
+        )
+        if not dry:
+            stage.check_missing_outputs()
+
+    elif stage.is_import:
+        logger.info(
+            "Importing '{dep}' -> '{out}'".format(
+                dep=stage.deps[0], out=stage.outs[0]
+            )
+        )
+        if not dry:
+            if (
+                not force
+                and not stage.stage_changed(warn=True)
+                and stage._already_cached()
+            ):
+                stage.outs[0].checkout()
+            else:
+                stage.deps[0].download(stage.outs[0])
+    elif stage.is_data_source:
+        logger.info("Verifying data sources in {}".format(stage))
+        if not dry:
+            stage.check_missing_outputs()
+
+    else:
+        stage_cached = False
+        if not dry:
+            stage_cache = stage.repo.stage_cache
+            stage_cached = (
+                not force
+                and not stage.is_callback
+                and not stage.always_changed
+                and stage._already_cached()
+            )
+            use_run_cache = False
+            if not stage_cached:
+                stage._save_deps()
+                use_run_cache = (
+                    not force
+                    and run_cache
+                    and stage_cache.is_cached(stage)
+                )
+
+            if use_run_cache:
+                stage_cache.restore(stage)
+                stage_cached = stage._outs_cached()
+
+        if stage_cached:
+            logger.info("Stage is cached, skipping.")
+            stage.checkout()
+        else:
+            logger.info("Running command:\n\t{}".format(stage.cmd))
+            if not dry:
+                stage._run()
+
+    if dry:
+        return
+
+    if no_commit:
+        stage.save()
+    else:
+        stage.commit(force=True)
