+def test_repo_without_commits(tmp_dir):
+    from git import Repo as GitRepo
+
+    from dvc.repo import Repo
+
+    repo_dir = tmp_dir / "empty"
+    repo_dir.mkdir()
+    GitRepo.init(str(repo_dir)).close()
+    repo = Repo.init(str(repo_dir))
+    try:
+        (repo_dir / "file").write_text("text")
+        (repo_dir / "file.dvc").write_text(
+            "outs:\n- md5: {}\n  path: file\n".format(digest("text"))
+        )
+
+        assert repo.diff() == {
+            "added": [{"path": "file", "hash": digest("text")}],
+            "deleted": [],
+            "modified": [],
+        }
+    finally:
+        repo.close()
+
+
