@@ -75,6 +85,41 @@ def file_md5(fname):
     return (None, None)
 
 
+def _fobj_md5(fobj):
+    """Return an md5 for a binary tree-backed file object.
+
+    Tree implementations (notably ``GitTree``) expose repository files as
+    in-memory streams rather than local filesystem paths. Read one regular
+    chunk up front so text detection does not require seeking, which also
+    keeps this helper usable with non-seekable remote streams.
+    """
+    from dvc.istextfile import TEXT_CHARS
+
+    hash_md5 = hashlib.md5()
+    first = fobj.read(LOCAL_CHUNK_SIZE)
+    if isinstance(first, str):
+        first = first.encode("utf-8")
+
+    sample = first[:512]
+    binary = bool(
+        sample
+        and (
+            b"\x00" in sample
+            or float(len(sample.translate(None, TEXT_CHARS))) / len(sample)
+            > 0.30
+        )
+    )
+
+    data = first
+    while data:
+        hash_md5.update(data if binary else dos2unix(data))
+        data = fobj.read(LOCAL_CHUNK_SIZE)
+        if isinstance(data, str):
+            data = data.encode("utf-8")
+
+    return (hash_md5.hexdigest(), hash_md5.digest())
+
+
 def bytes_hash(byts, typ):
