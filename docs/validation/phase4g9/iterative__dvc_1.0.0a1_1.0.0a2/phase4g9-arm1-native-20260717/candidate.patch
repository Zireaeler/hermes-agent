+def test_file_md5_from_git_tree(tmp_dir, scm):
+    tmp_dir.gen("foo", "foo content")
+    expected = file_md5("foo")
+    scm.add(["foo"])
+    scm.commit("add foo")
+    tree = scm.get_tree("HEAD")
+    (tmp_dir / "foo").unlink()
+
+    assert istextfile("foo", tree=tree)
+    assert file_md5("foo", tree=tree) == expected
+    with tree.open("foo", "rb") as fobj:
+        assert istextfile(fobj)
+        assert file_md5(fobj) == expected
+
