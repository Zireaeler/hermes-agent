diff --git a/dvc/command/plots.py b/dvc/command/plots.py
new file mode 100644
index 0000000..e8fbc40
--- /dev/null
+++ b/dvc/command/plots.py
@@ -0,0 +1,21 @@
+"""CLI implementation for ``dvc plots``.
+
+The repository plotting API remains singular (it produces one plot
+specification), while the user-facing command groups plot operations under
+the plural ``plots`` namespace.
+"""
+
+from dvc.command.plot import CmdPLot, CmdPlotDiff, CmdPlotShow, add_parser
+
+CmdPlots = CmdPLot
+CmdPlotsShow = CmdPlotShow
+CmdPlotsDiff = CmdPlotDiff
+
+__all__ = [
+    "CmdPlots",
+    "CmdPlotsShow",
+    "CmdPlotsDiff",
+    "CmdPlotShow",
+    "CmdPlotDiff",
+    "add_parser",
+]
diff --git a/tests/func/test_plot_markers.py b/tests/func/test_plot_markers.py
new file mode 100644
index 0000000..c9317fb
--- /dev/null
+++ b/tests/func/test_plot_markers.py
@@ -0,0 +1,36 @@
+import yaml
+
+from dvc.dvcfile import Dvcfile, PIPELINE_FILE
+
+
+def test_pipeline_plot_marker(tmp_dir, dvc):
+    dvc.run(
+        cmd="echo plot",
+        name="render-plot",
+        plots=["plot.json"],
+        no_exec=True,
+    )
+
+    data = yaml.safe_load((tmp_dir / PIPELINE_FILE).read_text())
+    assert data["stages"]["render-plot"]["plots"] == ["plot.json"]
+
+    out = Dvcfile(dvc, PIPELINE_FILE).stages["render-plot"].outs[0]
+    assert out.plot
+    assert out.use_cache
+
+
+def test_single_stage_plot_marker(tmp_dir, dvc):
+    dvc.run(
+        cmd="",
+        plots_no_cache=["plot.json"],
+        no_exec=True,
+        single_stage=True,
+    )
+
+    data = yaml.safe_load((tmp_dir / "plot.json.dvc").read_text())
+    assert data["outs"][0]["plot"] is True
+    assert data["outs"][0]["cache"] is False
+
+    out = Dvcfile(dvc, "plot.json.dvc").stage.outs[0]
+    assert out.plot
+    assert not out.use_cache
