diff --git a/dvc/stage/run.py b/dvc/stage/run.py
new file mode 100644
index 0000000..6107db6
--- /dev/null
+++ b/dvc/stage/run.py
@@ -0,0 +1,96 @@
+import logging
+
+
+logger = logging.getLogger(__name__)
+
+
+def cmd_run(stage, dry=False):
+    """Report a stage command and execute it unless this is a preview."""
+    logger.info("Running command:\n\t{}".format(stage.cmd))
+    if not dry:
+        stage._run()
+
+
+def run_stage(
+    stage,
+    dry=False,
+    no_commit=False,
+    force=False,
+    run_cache=True,
+):
+    """Run (or preview) a stage.
+
+    Keeping this orchestration outside :class:`Stage` gives callers a small,
+    independently testable boundary.  ``Stage.run()`` owns the repository
+    read/write lock and delegates here.
+
+    The run-cache option is deliberately positive at this internal boundary.
+    Public repository methods translate legacy negative options before a
+    stage is run.
+    """
+    if (stage.cmd or stage.is_import) and not stage.locked and not dry:
+        stage.remove_outs(ignore_remove=False, force=False)
+
+    if stage.locked:
+        logger.info("Verifying outputs in locked {stage}".format(stage=stage))
+        if not dry:
+            stage.check_missing_outputs()
+
+    elif stage.is_import:
+        logger.info(
+            "Importing '{dep}' -> '{out}'".format(
+                dep=stage.deps[0], out=stage.outs[0]
+            )
+        )
+        if not dry:
+            if (
+                not force
+                and not stage.stage_changed(warn=True)
+                and stage._already_cached()
+            ):
+                stage.outs[0].checkout()
+            else:
+                stage.deps[0].download(stage.outs[0])
+
+    elif stage.is_data_source:
+        logger.info("Verifying data sources in {}".format(stage))
+        if not dry:
+            stage.check_missing_outputs()
+
+    else:
+        if dry:
+            # A dry run is a command preview.  In particular, do not cross
+            # the ``_run`` execution boundary (which releases the repo lock),
+            # inspect/restore run cache, or mutate outputs merely to report it.
+            cmd_run(stage, dry=True)
+        else:
+            stage_cache = stage.repo.stage_cache
+            stage_cached = (
+                not force
+                and not stage.is_callback
+                and not stage.always_changed
+                and stage._already_cached()
+            )
+            use_run_cache = False
+            if not stage_cached:
+                stage._save_deps()
+                use_run_cache = (
+                    not force
+                    and run_cache
+                    and stage_cache.is_cached(stage)
+                )
+
+            if use_run_cache:
+                stage_cache.restore(stage)
+                stage_cached = stage._outs_cached()
+
+            if stage_cached:
+                logger.info("Stage is cached, skipping.")
+                stage._checkout()
+            else:
+                cmd_run(stage)
+
+    if not dry:
+        stage.save(no_commit=no_commit)
+        if not no_commit:
+            stage._commit()
