new file mode 100644
index 0000000..d2f1a18
--- /dev/null
+++ b/dvc/repo/plots/diff.py
@@ -0,0 +1,36 @@
+"""Generate plots comparing revisions."""
+
+# The plural plots API uses the same revision label as the rest of the
+# repository reporting APIs.  The legacy singular renderer still calls its
+# workspace revision ``workspace``; ``diff()`` translates at that boundary.
+from dvc.repo.plots.data import (
+    WORKSPACE_REVISION_NAME as WORKING_TREE_REVISION,
+)
+
+
+def _revisions(revisions, is_dirty):
+    revisions = list(revisions or [])
+    if len(revisions) <= 1:
+        if not revisions and is_dirty:
+            revisions.append("HEAD")
+        revisions.append(WORKING_TREE_REVISION)
+    return revisions
+
+
+def diff(repo, *args, revs=None, revisions=None, **kwargs):
+    if revs is not None:
+        if revisions is not None and revisions != revs:
+            raise TypeError("both 'revs' and 'revisions' were specified")
+        revisions = revs
+
+    revs = _revisions(revisions, repo.scm.is_dirty())
+
+    # Keep the compatibility renderer's established datapoint label while
+    # exposing the canonical public revision selection from ``_revisions``.
+    from dvc.repo.plot.data import WORKSPACE_REVISION_NAME
+
+    renderer_revs = [
+        WORKSPACE_REVISION_NAME if rev == WORKING_TREE_REVISION else rev
+        for rev in revs
+    ]
+    return repo.plots.show(*args, revs=renderer_revs, **kwargs)
diff --git a/dvc/repo/plots/show.py b/dvc/repo/plots/show.py
new file mode 100644
index 0000000..50a3077
--- /dev/null
+++ b/dvc/repo/plots/show.py
@@ -0,0 +1,55 @@
+"""Generate a plot for a structured data file."""
+
+from dvc.repo.plot import (  # noqa: F401
+    DIV_HTML,
+    PAGE_HTML,
+    NoDataOrTemplateProvided,
+    TooManyDataSourcesError,
+    _evaluate_templatepath,
+    _infer_y_field,
+    _parse_template,
+    fill_template,
+    plot as _plot,
+)
+
+
+def show(
+    repo,
+    targets=None,
+    template=None,
+    revs=None,
+    embed=False,
+    datafile=None,
+    revisions=None,
+    **kwargs
+):
+    # The rendering implementation predates the public plural namespace. It
+    # remains the single source of truth so that Repo.plot and Repo.plots.show
+    # produce byte-for-byte identical plot specifications.
+    # ``targets`` is the public spelling used by the plural plots API. Plot
+    # rendering still supports one data source at this point, so it maps to
+    # the older renderer's ``datafile`` argument. Keep ``datafile`` as a
+    # compatibility spelling for callers of the transitional API.
+    if targets is not None:
+        if datafile is not None and datafile != targets:
+            raise TypeError("both 'targets' and 'datafile' were specified")
+        if isinstance(targets, (list, tuple)):
+            if len(targets) > 1:
+                raise TooManyDataSourcesError(None, targets)
+            datafile = targets[0] if targets else None
+        else:
+            datafile = targets
+
+    if revs is not None:
+        if revisions is not None and revisions != revs:
+            raise TypeError("both 'revs' and 'revisions' were specified")
+        revisions = revs
+
+    return _plot(
+        repo,
+        datafile=datafile,
+        template=template,
+        revisions=revisions,
+        embed=embed,
+        **kwargs
+    )
