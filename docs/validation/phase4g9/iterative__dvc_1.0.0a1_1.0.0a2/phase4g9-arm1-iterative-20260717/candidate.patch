+    os.makedirs(dvc.cache.local.cache_dir)
+    dvc.pull(run_cache=True)
+
+    first_local = dvc.cache.local.checksum_to_path_info(first_checksum)
+    second_local = dvc.cache.local.checksum_to_path_info(second_checksum)
+    assert dvc.cache.local.exists(first_local)
+    assert dvc.cache.local.exists(second_local)
+
+
+def test_pull_collects_run_cache_directory_children(
+    tmp_dir, dvc, local_remote
+):
+    tmp_dir.gen(
+        {
+            "dep": "first",
+            "copy_dir.py": (
+                "import os, shutil, sys\n"
+                "os.makedirs(sys.argv[2])\n"
+                "shutil.copyfile(sys.argv[1], "
+                "os.path.join(sys.argv[2], 'file'))\n"
+            ),
+        }
+    )
+    stage = dvc.run(
+        cmd="python copy_dir.py dep outdir",
+        deps=["copy_dir.py", "dep"],
+        outs=["outdir"],
+        single_stage=True,
+    )
+    first_child = stage.outs[0].dir_cache[0]["md5"]
+
+    tmp_dir.gen("dep", "second")
+    dvc.reproduce(stage.path)
+    current = dvc.find_out_by_relpath("outdir")
+    second_child = current.dir_cache[0]["md5"]
+    assert first_child != second_child
+
+    dvc.push(run_cache=True)
+    remove(dvc.cache.local.cache_dir)
+    os.makedirs(dvc.cache.local.cache_dir)
+    dvc.cache.local._dir_info.clear()
+    dvc.pull(run_cache=True)
+
+    first_local = dvc.cache.local.checksum_to_path_info(first_child)
+    second_local = dvc.cache.local.checksum_to_path_info(second_child)
+    assert dvc.cache.local.exists(first_local)
+    assert dvc.cache.local.exists(second_local)
+
+
+def test_push_pull_collects_uncached_directory_run_cache(
+    tmp_dir, dvc, local_remote
+):
+    tmp_dir.gen(
+        {
+            "dep": "first",
+            "copy_dir.py": (
+                "import os, shutil, sys\n"
+                "os.makedirs(sys.argv[2])\n"
+                "shutil.copyfile(sys.argv[1], "
+                "os.path.join(sys.argv[2], 'file'))\n"
+                "with open('counter', 'a') as fobj:\n"
+                "    fobj.write('run\\n')\n"
+            ),
+        }
+    )
+    stage = dvc.run(
+        cmd="python copy_dir.py dep outdir",
+        deps=["copy_dir.py", "dep"],
+        outs_no_cache=["outdir"],
+        single_stage=True,
+    )
+
+    tmp_dir.gen("dep", "second")
+    dvc.reproduce(stage.path)
+    dvc.push(run_cache=True)
+
+    remove(dvc.cache.local.cache_dir)
+    os.makedirs(dvc.cache.local.cache_dir)
+    dvc.cache.local._dir_info.clear()
+    dvc.pull(run_cache=True)
+
+    tmp_dir.gen("dep", "first")
+    dvc.reproduce(stage.path)
+
+    assert (tmp_dir / "outdir" / "file").read_text() == "first"
+    assert (tmp_dir / "counter").read_text().splitlines() == ["run", "run"]
+
