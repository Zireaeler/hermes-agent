diff --git a/dvc/command/plots.py b/dvc/command/plots.py
new file mode 100644
index 0000000..c026820
--- /dev/null
+++ b/dvc/command/plots.py
@@ -0,0 +1,390 @@
+import argparse
+import json
+import logging
+import os
+
+from dvc.command.base import CmdBase, append_doc_link, fix_subparsers
+from dvc.exceptions import DvcException
+
+logger = logging.getLogger(__name__)
+
+
+class CmdPlots(CmdBase):
+    """Common implementation for ``dvc plots show`` and ``diff``."""
+
+    def _func(self):
+        raise NotImplementedError
+
+    def _result_file(self):
+        if self.args.file:
+            return self.args.file
+        return self._result_basename() + self._result_extension()
+
+    def _result_basename(self):
+        target = self._target()
+        if isinstance(target, (list, tuple)):
+            # The plural command accepts multiple targets.  A target-derived
+            # output name is only unambiguous for a single target.
+            if len(target) == 1:
+                return target[0]
+            return "plots"
+        if target:
+            return target
+        return "plots"
+
+    def _result_extension(self):
+        if not (self.args.no_html or self.args.show_json):
+            return ".html"
+        if self.args.template:
+            return os.path.splitext(self.args.template)[-1]
+        return ".json"
+
+    def _revisions(self):
+        return None
+
+    def _target(self):
+        return (
+            getattr(self.args, "targets", None)
+            or getattr(self.args, "pos_targets", None)
+            or getattr(self.args, "datafile", None)
+        )
+
+    def _target_kwargs(self):
+        return {"targets": self._target()}
+
+    def _revision_kwargs(self):
+        return {"revs": self._revisions()}
+
+    def _embed_kwargs(self):
+        # HTML wrapping is a renderer implementation detail and is not part
+        # of the public ``Repo.plots`` command contract.
+        return {}
+
+    def run(self):
+        fields = None
+        jsonpath = None
+        if self.args.select:
+            if self.args.select.startswith("$"):
+                jsonpath = self.args.select
+            else:
+                fields = set(self.args.select.split(","))
+
+        try:
+            plot_string = self._func()(
+                **self._target_kwargs(),
+                **self._revision_kwargs(),
+                template=self.args.template,
+                fields=fields,
+                x_field=self.args.x,
+                y_field=self.args.y,
+                path=jsonpath,
+                **self._embed_kwargs(),
+                csv_header=not self.args.no_csv_header,
+                title=self.args.title,
+                x_title=self.args.xlab,
+                y_title=self.args.ylab,
+            )
+
+            if self.args.show_json and isinstance(plot_string, (dict, list)):
+                plot_string = json.dumps(plot_string)
+
+            if self.args.stdout or self.args.show_json:
+                logger.info(plot_string)
+            else:
+                result_path = self._result_file()
+                with open(result_path, "w") as fobj:
+                    fobj.write(plot_string)
+
+                logger.info(
+                    "file://{}".format(
+                        os.path.join(self.repo.root_dir, result_path)
+                    )
+                )
+        except DvcException:
+            logger.exception("")
+            return 1
+
+        return 0
+
+
+class CmdPlotsShow(CmdPlots):
+    def _func(self):
+        return self.repo.plots.show
+
+    def _revisions(self):
+        return getattr(self.args, "revs", None)
+
+    def _revision_kwargs(self):
+        revs = self._revisions()
+        return {} if revs is None else {"revs": revs}
+
+
+class CmdPlotsDiff(CmdPlots):
+    def _func(self):
+        return self.repo.plots.diff
+
+    def _revisions(self):
+        # Revision defaults are part of the repository API. Keeping them out
+        # of the command layer also makes direct ``Repo.plots.diff`` calls
+        # behave the same as CLI calls.
+        revs = getattr(self.args, "revs", None)
+        if revs is not None:
+            return revs
+        return self.args.revisions
+
+
+class CmdPlotShow(CmdPlotsShow):
+    """Compatibility command for the former singular spelling."""
+
+    def _func(self):
+        return self.repo.plot
+
+    def _target_kwargs(self):
+        return {"datafile": self._target()}
+
+    def _revision_kwargs(self):
+        return {"revisions": self._revisions()}
+
+    def _embed_kwargs(self):
+        return {
+            "embed": not (self.args.no_html or self.args.show_json),
+        }
+
+
+class CmdPlotDiff(CmdPlotsDiff):
+    """Compatibility command for the former singular spelling."""
+
+    def _func(self):
+        return self.repo.plot
+
+    def _target_kwargs(self):
+        return {"datafile": self._target()}
+
+    def _revision_kwargs(self):
+        return {"revisions": self._revisions()}
+
+    def _embed_kwargs(self):
+        return {
+            "embed": not (self.args.no_html or self.args.show_json),
+        }
+
+    def _revisions(self):
+        from dvc.repo.plots.diff import _revisions
+        from dvc.repo.plots.diff import WORKING_TREE_REVISION
+        from dvc.repo.plot.data import WORKSPACE_REVISION_NAME
+
+        revisions = self.args.revisions or []
+        is_dirty = not revisions and self.repo.scm.is_dirty()
+        return [
+            WORKSPACE_REVISION_NAME
+            if rev == WORKING_TREE_REVISION
+            else rev
+            for rev in _revisions(revisions, is_dirty)
+        ]
+
+
+def _add_common_args(parser):
+    parser.add_argument(
+        "-t",
+        "--template",
+        nargs="?",
+        default=None,
+        help="File to be injected with data.",
+    )
+    parser.add_argument(
+        "-f",
+        "-o",
+        "--file",
+        "--out",
+        default=None,
+        help="Name of the generated file.",
+    )
+    parser.add_argument(
+        "-s",
+        "--select",
+        default=None,
+        help="Choose which field(s) or JSONPath to include in the plot.",
+    )
+    parser.add_argument("-x", default=None, help="Field name for x axis.")
+    parser.add_argument("-y", default=None, help="Field name for y axis.")
+    parser.add_argument(
+        "--stdout",
+        action="store_true",
+        default=False,
+        help="Print plot specification to stdout.",
+    )
+    parser.add_argument(
+        "--show-json",
+        action="store_true",
+        default=False,
+        help="Show plot specification in JSON format.",
+    )
+    parser.add_argument(
+        "--no-csv-header",
+        action="store_true",
+        default=False,
+        help="Required when CSV or TSV datafile does not have a header.",
+    )
+    parser.add_argument(
+        "--no-html",
+        action="store_true",
+        default=False,
+        help="Do not wrap Vega plot JSON with HTML.",
+    )
+    parser.add_argument("--title", default=None, help="Plot title.")
+    parser.add_argument("--xlab", default=None, help="X axis title.")
+    parser.add_argument("--ylab", default=None, help="Y axis title.")
+
+
+def _add_plots_parser(
+    subparsers,
+    parent_parser,
+    name,
+    show_class,
+    diff_class,
+    help_text,
+    plural=False,
+):
+    plots_parser = subparsers.add_parser(
+        name,
+        parents=[parent_parser],
+        description=append_doc_link(help_text, "plots"),
+        help=help_text,
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    plots_subparsers = plots_parser.add_subparsers(
+        dest="cmd",
+        help="Use `dvc plots CMD --help` to display command-specific help.",
+    )
+    fix_subparsers(plots_subparsers)
+
+    show_help = "Generate plots from metrics."
+    show_parser = plots_subparsers.add_parser(
+        "show",
+        parents=[parent_parser],
+        description=append_doc_link(show_help, "plots/show"),
+        help=show_help,
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    _add_common_args(show_parser)
+    if plural:
+        show_parser.add_argument(
+            "pos_targets",
+            nargs="*",
+            help="Plot files to visualize.",
+        )
+        show_parser.add_argument(
+            "--targets",
+            nargs="*",
+            default=None,
+            metavar="<paths>",
+            help="Plot files to visualize.",
+        )
+        show_parser.add_argument(
+            "-d",
+            "--datafile",
+            dest="targets",
+            help="Plot file to visualize.",
+        )
+        show_parser.add_argument(
+            "--revs",
+            "--rev",
+            "--revisions",
+            nargs="*",
+            default=None,
+            metavar="<revisions>",
+            help="Git revisions to plot from.",
+        )
+    else:
+        show_parser.add_argument(
+            "datafile",
+            nargs="?",
+            default=None,
+            help="Metrics file to visualize.",
+        )
+    show_parser.set_defaults(func=show_class)
+
+    diff_help = (
+        "Show changes in plots between commits in the DVC repository, or "
+        "between a commit and the workspace."
+    )
+    diff_parser = plots_subparsers.add_parser(
+        "diff",
+        parents=[parent_parser],
+        description=append_doc_link(diff_help, "plots/diff"),
+        help=diff_help,
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    _add_common_args(diff_parser)
+    if plural:
+        diff_parser.add_argument(
+            "-d",
+            "--datafile",
+            "--targets",
+            dest="targets",
+            nargs="*",
+            default=None,
+            metavar="<paths>",
+            help="Plot files to visualize.",
+        )
+    else:
+        diff_parser.add_argument(
+            "-d",
+            "--datafile",
+            nargs="?",
+            default=None,
+            help="Metrics file to visualize.",
+        )
+    diff_parser.add_argument(
+        "revisions",
+        nargs="*",
+        default=None,
+        help="Git revisions to plot from.",
+    )
+    if plural:
+        diff_parser.add_argument(
+            "--revs",
+            "--rev",
+            "--revisions",
+            nargs="*",
+            default=None,
+            metavar="<revisions>",
+            help="Git revisions to plot from.",
+        )
+    diff_parser.set_defaults(func=diff_class)
+
+
+def add_parser(subparsers, parent_parser):
+    plots_help = "Visualize and compare plot data in structured files."
+    _add_plots_parser(
+        subparsers,
+        parent_parser,
+        "plots",
+        CmdPlotsShow,
+        CmdPlotsDiff,
+        plots_help,
+        plural=True,
+    )
+    _add_plots_parser(
+        subparsers,
+        parent_parser,
+        "plot",
+        CmdPlotShow,
+        CmdPlotDiff,
+        "Alias for the `plots` command.",
+    )
+
+
+# Compatibility spellings used by integrations before the plural rename.
+CmdPLot = CmdPlots
+
+
+__all__ = [
+    "CmdPlots",
+    "CmdPlotsDiff",
+    "CmdPlotsShow",
+    "CmdPLot",
+    "CmdPlotDiff",
+    "CmdPlotShow",
+    "add_parser",
+]
