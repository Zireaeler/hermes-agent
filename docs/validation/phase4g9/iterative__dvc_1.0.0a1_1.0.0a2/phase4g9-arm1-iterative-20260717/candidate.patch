+++ b/dvc/repo/plots/__init__.py
@@ -0,0 +1,57 @@
+"""Plot repository API.
+
+``Repo.plots`` is a namespace, like ``Repo.metrics`` and ``Repo.params``.
+The singular ``Repo.plot`` call remains available as a compatibility API.
+"""
+
+from dvc.repo.plot import (
+    DIV_HTML,
+    PAGE_HTML,
+    NoDataOrTemplateProvided,
+    TooManyDataSourcesError,
+    _evaluate_templatepath,
+    _infer_y_field,
+    _parse_template,
+    fill_template,
+)
+from dvc.repo.plots.data import PlotData
+from dvc.repo.plots.template import NoDataForTemplateError, Template
+
+
+class Plots:
+    def __init__(self, repo):
+        self.repo = repo
+
+    def show(self, *args, **kwargs):
+        from dvc.repo.plots.show import show
+
+        return show(self.repo, *args, **kwargs)
+
+    def diff(self, *args, **kwargs):
+        from dvc.repo.plots.diff import diff
+
+        return diff(self.repo, *args, **kwargs)
+
+    @property
+    def templates(self):
+        return self.repo.plots_templates
+
+    def __call__(self, *args, **kwargs):
+        """Compatibility for the short-lived callable plural API."""
+        return self.show(*args, **kwargs)
+
+
+__all__ = [
+    "DIV_HTML",
+    "PAGE_HTML",
+    "NoDataOrTemplateProvided",
+    "NoDataForTemplateError",
+    "PlotData",
+    "Plots",
+    "Template",
+    "TooManyDataSourcesError",
+    "_evaluate_templatepath",
+    "_infer_y_field",
+    "_parse_template",
+    "fill_template",
+]
