+import json
+
+import pytest
+
+from dvc.repo.plot import PAGE_HTML
+from dvc.repo.plot.data import NoMetricInHistoryError, PlotMetricTypeError
+from dvc.repo.plot.template import (
+    DefaultLinearTemplate,
+    NoDataForTemplateError,
+    TemplateNotFoundError,
+)
+from dvc.repo.plots import NoDataOrTemplateProvided
+from dvc.repo.plots.show import show
+
+
+def test_plot_html_has_doctype():
+    assert PAGE_HTML.startswith("<!DOCTYPE html>\n")
+
+
+def test_default_plot_does_not_force_zero_y_axis(tmp_path):
+    template = DefaultLinearTemplate(str(tmp_path))
+    template.dump()
+    path = tmp_path / "default.json"
+
+    assert path.read_bytes().endswith(b"\n")
+    content = json.loads(path.read_text())
+    assert content["encoding"]["y"]["scale"] == {"zero": False}
+
+
+def test_show_accepts_datafile_keyword(tmp_dir, dvc):
+    tmp_dir.gen("metric.txt", "metric")
+    with pytest.raises(PlotMetricTypeError):
+        dvc.plots.show(datafile="metric.txt")
+
+
+def test_show_omits_unspecified_revisions(dvc, mocker):
+    show = mocker.patch("dvc.repo.plots.show.show", return_value={})
+
+    dvc.plots.show(targets=["metrics.json"], template="template")
+
+    show.assert_called_once_with(
+        dvc,
+        targets=["metrics.json"],
+        template="template",
+    )
+
+
+def test_show_exception_contracts(dvc):
+    with pytest.raises(NoDataOrTemplateProvided):
+        dvc.plots.show()
+    with pytest.raises(NoDataForTemplateError):
+        dvc.plots.show(template="default")
+    with pytest.raises(TemplateNotFoundError):
+        dvc.plots.show(
+            datafile="metric.json", template="missing-template.json"
+        )
+    with pytest.raises(NoMetricInHistoryError):
+        dvc.plots.show(datafile="missing.json")
+    with pytest.raises(NoMetricInHistoryError):
+        dvc.plots.show(
+            datafile="missing.json", revisions=["working tree"]
+        )
+
+
+def test_module_show_legacy_keywords_preserve_exceptions(tmp_dir, dvc):
+    tmp_dir.gen("metric.txt", "metric")
+    with pytest.raises(NoDataOrTemplateProvided):
+        show(dvc)
+    with pytest.raises(NoDataForTemplateError):
+        show(dvc, template="default")
+    with pytest.raises(TemplateNotFoundError):
+        show(
+            dvc,
+            datafile="metric.json",
+            template="missing-template.json",
+        )
+    with pytest.raises(PlotMetricTypeError):
+        show(dvc, datafile="metric.txt", revisions=["working tree"])
+    with pytest.raises(NoMetricInHistoryError):
+        show(dvc, datafile="missing.json", revisions=["working tree"])
