+from dvc.repo.plot import (
+    NoDataOrTemplateProvided,
+    TooManyDataSourcesError,
+    fill_template,
+    plot,
+)
+
+
+class Plots:
+    """Repository plotting interface."""
+
+    def __init__(self, repo):
+        self.repo = repo
+
+    def show(self, targets=None, template=None, **kwargs):
+        from .show import show
+
+        datafile = kwargs.pop("datafile", None)
+        if targets is None:
+            targets = datafile
+        revs = kwargs.pop("revs", None)
+        if revs is None:
+            revs = kwargs.pop("revisions", None)
+
+        if revs is not None:
+            kwargs["revs"] = revs
+        return show(self.repo, targets=targets, template=template, **kwargs)
+
+    def diff(self, targets=None, revs=None, template=None, **kwargs):
+        from .diff import diff
+
+        datafile = kwargs.pop("datafile", None)
+        if targets is None:
+            targets = datafile
+        if revs is None:
+            revs = kwargs.pop("revisions", None)
+        return diff(
+            self.repo,
+            targets=targets,
+            template=template,
+            revs=revs,
+            **kwargs
+        )
+
+
+__all__ = [
+    "NoDataOrTemplateProvided",
+    "Plots",
+    "TooManyDataSourcesError",
+    "fill_template",
+    "plot",
+]
