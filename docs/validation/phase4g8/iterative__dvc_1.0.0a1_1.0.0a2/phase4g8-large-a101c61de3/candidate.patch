new file mode 100644
index 0000000..bac9002
--- /dev/null
+++ b/dvc/repo/plots/diff.py
@@ -0,0 +1,33 @@
+from dvc.repo.plot import plot
+from dvc.repo.plots.data import WORKSPACE_REVISION_NAME
+from dvc.repo.plots.utils import collect_targets
+
+
+def _revisions(revs=None, is_dirty=False, no_commits=False):
+    revs = list(revs or [])
+    if len(revs) <= 1:
+        if not revs and is_dirty and not no_commits:
+            revs.append("HEAD")
+        revs.append(WORKSPACE_REVISION_NAME)
+    return revs
+
+
+def diff(repo, targets=None, revs=None, template=None, **kwargs):
+    datafile = kwargs.pop("datafile", None)
+    if targets is None:
+        targets = datafile
+    targets = collect_targets(repo, targets)
+    if revs is None:
+        revs = kwargs.pop("revisions", None)
+    revs = _revisions(revs, repo.scm.is_dirty(), repo.scm.no_commits)
+
+    return {
+        target: plot(
+            repo,
+            datafile=target,
+            template=template,
+            revisions=revs,
+            **kwargs
+        )
+        for target in targets
+    }
