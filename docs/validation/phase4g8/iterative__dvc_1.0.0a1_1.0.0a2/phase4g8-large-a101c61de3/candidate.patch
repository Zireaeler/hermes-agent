+++ b/dvc/repo/plots/utils.py
@@ -0,0 +1,13 @@
+def collect_targets(repo, targets=None):
+    """Return requested plot targets or discover outputs marked as plots."""
+    if isinstance(targets, str):
+        return [targets]
+    if targets:
+        return list(targets)
+
+    discovered = []
+    for stage in repo.stages:
+        for out in stage.outs:
+            if out.plot and str(out) not in discovered:
+                discovered.append(str(out))
+    return discovered or [None]
