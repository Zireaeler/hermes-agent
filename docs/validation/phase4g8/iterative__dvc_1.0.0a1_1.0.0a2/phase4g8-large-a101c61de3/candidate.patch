+from dvc.cli import parse_args
+from dvc.command.plots import CmdPlotsDiff, CmdPlotsShow
+from dvc.repo.plots.diff import _revisions
+
+
+def test_plots_show_stdout(dvc, mocker, caplog):
+    args = parse_args(["plots", "show", "metrics.json", "--stdout"])
+    assert args.func is CmdPlotsShow
+    cmd = args.func(args)
+    mocker.patch.object(
+        cmd.repo.plots, "show", return_value={"metrics.json": "{}"}
+    )
+
+    assert cmd.run() == 0
+    assert "<!DOCTYPE html>" in caplog.text
+
+
+def test_plots_diff_parser(dvc):
+    args = parse_args(["plots", "diff", "HEAD~1", "--show-vega"])
+    assert args.func is CmdPlotsDiff
+    assert args.show_json
+
+
+def test_revisions_without_commits():
+    assert _revisions(is_dirty=True, no_commits=True) == ["working tree"]
+
+
+def test_plots_diff_call(dvc, mocker):
+    args = parse_args(
+        [
+            "plots",
+            "diff",
+            "--file",
+            "result.html",
+            "--template",
+            "template",
+            "--datafile",
+            "datafile",
+            "--select",
+            "column1,column2",
+            "--stdout",
+            "HEAD",
+            "tag1",
+        ]
+    )
+    cmd = args.func(args)
+    plots_diff = mocker.patch.object(
+        cmd.repo.plots, "diff", autospec=True, return_value={}
+    )
+
+    assert cmd.run() == 0
+    plots_diff.assert_called_once_with(
+        targets=["datafile"],
+        template="template",
+        fields={"column1", "column2"},
+        path=None,
+        x_field=None,
+        y_field=None,
+        csv_header=True,
+        title=None,
+        x_title=None,
+        y_title=None,
+        revs=["HEAD", "tag1"],
+    )
+
+
+def test_plots_diff_json_in_no_scm_repo(dvc, mocker, caplog):
+    args = parse_args(
+        ["plots", "diff", "--datafile", "metrics.json", "--show-json"]
+    )
+    cmd = args.func(args)
+    mocker.patch.object(
+        cmd.repo.plots,
+        "diff",
+        autospec=True,
+        return_value={"metrics.json": "{}"},
+    )
+
+    assert cmd.run() == 0
+    assert '"metrics.json": "{}"' in caplog.text
