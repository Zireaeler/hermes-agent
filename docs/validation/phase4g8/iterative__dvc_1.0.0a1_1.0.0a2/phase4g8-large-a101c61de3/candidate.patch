diff --git a/dvc/command/plots.py b/dvc/command/plots.py
new file mode 100644
index 0000000..f6c6e7c
--- /dev/null
+++ b/dvc/command/plots.py
@@ -0,0 +1,151 @@
+import argparse
+import json
+import logging
+import os
+
+from dvc.command.base import CmdBase, append_doc_link, fix_subparsers
+from dvc.exceptions import DvcException
+from dvc.repo.plot import DIV_HTML, PAGE_HTML
+from dvc.repo.plots.diff import _revisions
+from dvc.utils.fs import makedirs
+
+logger = logging.getLogger(__name__)
+
+
+class CmdPlots(CmdBase):
+    operation = None
+
+    def _result_file(self):
+        if self.args.file:
+            return self.args.file
+        if not self.args.no_html:
+            extension = ".html"
+        elif self.args.template:
+            extension = os.path.splitext(self.args.template)[-1]
+        else:
+            extension = ".json"
+        return os.path.join("dvc_plots", "index" + extension)
+
+    def _kwargs(self):
+        fields = None
+        jsonpath = None
+        if self.args.select:
+            if self.args.select.startswith("$"):
+                jsonpath = self.args.select
+            else:
+                fields = set(self.args.select.split(","))
+        return {
+            "targets": self.args.targets,
+            "template": self.args.template,
+            "fields": fields,
+            "path": jsonpath,
+            "x_field": self.args.x,
+            "y_field": self.args.y,
+            "csv_header": not self.args.no_csv_header,
+            "title": self.args.title,
+            "x_title": self.args.xlab,
+            "y_title": self.args.ylab,
+        }
+
+    @staticmethod
+    def _html(plots):
+        if not isinstance(plots, dict):
+            return plots
+        divs = "\n".join(
+            DIV_HTML.format(id=target, vega_json=plot)
+            for target, plot in plots.items()
+        )
+        return PAGE_HTML.format(divs=divs)
+
+    def run(self):
+        try:
+            kwargs = self._kwargs()
+            if self.operation == "diff":
+                kwargs["revs"] = _revisions(
+                    self.args.revisions,
+                    self.repo.scm.is_dirty(),
+                )
+            result = getattr(self.repo.plots, self.operation)(**kwargs)
+
+            if self.args.show_json:
+                logger.info(json.dumps(result))
+            elif self.args.stdout:
+                logger.info(self._html(result))
+            else:
+                result_path = self._result_file()
+                parent = os.path.dirname(result_path)
+                if parent:
+                    makedirs(parent, exist_ok=True)
+                with open(result_path, "w") as fobj:
+                    fobj.write(self._html(result))
+                logger.info(
+                    "file://{}".format(
+                        os.path.join(self.repo.root_dir, result_path)
+                    )
+                )
+        except DvcException:
+            logger.exception("")
+            return 1
+        return 0
+
+
+class CmdPlotsShow(CmdPlots):
+    operation = "show"
+
+
+class CmdPlotsDiff(CmdPlots):
+    operation = "diff"
+
+
+def _add_common(parser, targets_positional=False):
+    parser.add_argument("-t", "--template", nargs="?", default=None)
+    parser.add_argument("-f", "--file", "-o", "--out", default=None)
+    parser.add_argument("-s", "--select", "--fields", default=None)
+    parser.add_argument("-x", default=None)
+    parser.add_argument("-y", default=None)
+    parser.add_argument("--stdout", action="store_true", default=False)
+    parser.add_argument(
+        "--show-json",
+        "--show-vega",
+        action="store_true",
+        default=False,
+    )
+    parser.add_argument(
+        "--no-csv-header",
+        "--no-header",
+        action="store_true",
+        default=False,
+    )
+    parser.add_argument("--no-html", action="store_true", default=False)
+    parser.add_argument("--title", default=None)
+    parser.add_argument("--xlab", default=None)
+    parser.add_argument("--ylab", default=None)
+    if targets_positional:
+        parser.add_argument("targets", nargs="*", default=None)
+    else:
+        parser.add_argument(
+            "-d", "--datafile", dest="targets", action="append"
+        )
+        parser.add_argument("--targets", dest="targets", nargs="*")
+
+
+def add_parser(subparsers, parent_parser):
+    help_text = "Generate plots from metrics stored in structured files."
+    parser = subparsers.add_parser(
+        "plots",
+        parents=[parent_parser],
+        description=append_doc_link(help_text, "plots"),
+        help=help_text,
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    commands = parser.add_subparsers(dest="cmd")
+    fix_subparsers(commands)
+
+    show = commands.add_parser("show", parents=[parent_parser])
+    _add_common(show, targets_positional=True)
+    show.set_defaults(func=CmdPlotsShow)
+
+    diff = commands.add_parser("diff", parents=[parent_parser])
+    _add_common(diff)
+    diff.add_argument("revisions", nargs="*", default=None)
+    diff.set_defaults(func=CmdPlotsDiff)
