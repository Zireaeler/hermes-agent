+    dropna = {"dropna": dropna} if dropna is not None else {}
+    observed = {"observed": observed} if observed is not None else {}
+    # Inputs are aligned by the preceding shuffle. Calling pandas directly also
+    # preserves the name of an external Series grouper in the result index.
