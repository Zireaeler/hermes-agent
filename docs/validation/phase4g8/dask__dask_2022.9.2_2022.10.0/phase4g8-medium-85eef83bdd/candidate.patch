+"""Common machinery for dispatching collection creation to backend libraries."""
+
+from __future__ import annotations
+
+from functools import partial
+
+from dask import config
+from dask.compatibility import entry_points
+
+
+class DaskBackendEntrypoint:
+    """Base class for backend entry-point implementations."""
+
+
+class CreationDispatch:
+    """Dispatch top-level collection creation functions by backend name."""
+
+    def __init__(self, module_name, default, entrypoint_root):
+        self.module_name = module_name
+        self.default = default
+        self.entrypoint_root = entrypoint_root
+        self._backends = {}
+        self._entrypoints_loaded = False
+
+    def register_backend(self, name, backend):
+        """Register an object implementing backend creation methods."""
+        if isinstance(backend, type):
+            backend = backend()
+        self._backends[name] = backend
+        return backend
+
+    def _load_entrypoints(self):
+        if self._entrypoints_loaded:
+            return
+        self._entrypoints_loaded = True
+        for entry_point in entry_points(group=self.entrypoint_root):
+            backend = entry_point.load()
+            self.register_backend(entry_point.name, backend)
+
+    def dispatch(self, backend=None):
+        if backend is None:
+            backend = config.get(f"{self.module_name}.backend", self.default)
+        if backend not in self._backends:
+            self._load_entrypoints()
+        try:
+            return self._backends[backend]
+        except KeyError as exc:
+            known = ", ".join(sorted(self._backends)) or "none"
+            raise ValueError(
+                f"No backend dispatch registered for {backend!r}; known backends: {known}"
+            ) from exc
+
+    def __getattr__(self, method):
+        if method.startswith("_"):
+            raise AttributeError(method)
+        return partial(self._call, method)
+
+    def _call(self, method, *args, backend=None, **kwargs):
+        implementation = self.dispatch(backend)
+        try:
+            func = getattr(implementation, method)
+        except AttributeError as exc:
+            raise NotImplementedError(
+                f"The {implementation!r} backend does not implement {method!r}"
+            ) from exc
+        return func(*args, **kwargs)
