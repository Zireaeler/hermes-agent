@@ -0,0 +1,75 @@
+import click
+import pytest
+from click.testing import CliRunner
+
+from dask import cli as dask_cli
+
+
+def test_cli_help_and_version():
+    runner = CliRunner()
+    result = runner.invoke(dask_cli.cli, ["--help"])
+    assert result.exit_code == 0
+    assert "docs" in result.output
+    assert "info" in result.output
+
+    result = runner.invoke(dask_cli.cli, ["--version"])
+    assert result.exit_code == 0
+
+
+def test_info_versions(monkeypatch):
+    called = []
+    monkeypatch.setattr(dask_cli, "show_versions", lambda: called.append(True))
+
+    result = CliRunner().invoke(dask_cli.versions)
+    assert result.exit_code == 0
+    assert called == [True]
+
+
+def test_register_command_entry_point():
+    @click.command(name="example")
+    def example():
+        click.echo("registered")
+
+    class EntryPoint:
+        name = "example"
+
+        def load(self):
+            return example
+
+    interface = click.Group()
+    dask_cli._register_command_ep(interface, [EntryPoint()])
+    result = CliRunner().invoke(interface, ["example"])
+    assert result.exit_code == 0
+    assert result.output == "registered\n"
+
+
+def test_register_command_entry_point_warns():
+    class EntryPoint:
+        name = "invalid"
+
+        def load(self):
+            return object()
+
+    with pytest.warns(UserWarning, match="must be instances of"):
+        dask_cli._register_command_ep(click.Group(), [EntryPoint()])
+
+
+def test_repeated_name_registration_warn():
+    @click.command(name="example")
+    def original():
+        pass
+
+    @click.command(name="example")
+    def replacement():
+        pass
+
+    class EntryPoint:
+        name = "example"
+
+        def load(self):
+            return replacement
+
+    interface = click.Group(commands={"example": original})
+    with pytest.warns(UserWarning, match="already registered"):
+        dask_cli._register_command_ep(interface, [EntryPoint()])
+    assert interface.commands["example"] is replacement
