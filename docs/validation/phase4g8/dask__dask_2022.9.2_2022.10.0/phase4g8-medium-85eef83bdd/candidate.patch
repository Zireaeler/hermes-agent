+++ b/dask/cli.py
@@ -0,0 +1,69 @@
+"""The extensible Dask command line interface."""
+
+from __future__ import annotations
+
+import warnings
+import webbrowser
+
+import click
+
+from dask import __version__
+from dask.compatibility import entry_points
+from dask.utils import show_versions
+
+
+@click.group(context_settings={"help_option_names": ["-h", "--help"]})
+@click.version_option(version=__version__)
+def cli():
+    """Dask command line interface."""
+
+
+@cli.command()
+def docs():
+    """Open the Dask documentation in a web browser."""
+    webbrowser.open("https://docs.dask.org")
+
+
+@cli.command(name="info")
+def versions():
+    """Print versions useful for bug reports."""
+    show_versions()
+
+
+def _register_command_ep(interface, command_entry_points):
+    """Register commands exposed through the ``dask_cli`` entry-point group."""
+    for entry_point in command_entry_points:
+        try:
+            command = entry_point.load()
+        except Exception as exc:
+            warnings.warn(
+                f"While registering the command with name {entry_point.name!r}, "
+                f"an error occurred: {exc}",
+                UserWarning,
+            )
+            continue
+
+        if not isinstance(command, click.Command):
+            warnings.warn(
+                "Dask CLI entry points must be instances of click.Command "
+                f"or click.Group, not {type(command)!r}",
+                UserWarning,
+            )
+            continue
+        if command.name in interface.commands:
+            warnings.warn(
+                f"A command named {command.name!r} is already registered; "
+                "the original has been overwritten",
+                UserWarning,
+            )
+        interface.add_command(command)
+
+
+def run_cli():
+    """Load command extensions and invoke the CLI."""
+    _register_command_ep(cli, entry_points(group="dask_cli"))
+    cli()
+
+
+if __name__ == "__main__":
+    run_cli()
