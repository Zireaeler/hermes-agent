+import pandas as pd
+
+import dask
+import dask.array as da
+import dask.dataframe as dd
+
+
+def test_array_creation_backend_dispatch(monkeypatch):
+    class Backend:
+        @staticmethod
+        def ones(*args, **kwargs):
+            return "array-backend"
+
+    monkeypatch.setitem(da.backends.array_creation_dispatch._backends, "test", Backend())
+    assert da.ones(3, backend="test") == "array-backend"
+    with dask.config.set({"array.backend": "test"}):
+        assert da.ones(3) == "array-backend"
+
+
+def test_dataframe_creation_backend_dispatch(monkeypatch):
+    class Backend:
+        @staticmethod
+        def from_pandas(*args, **kwargs):
+            return "dataframe-backend"
+
+    monkeypatch.setitem(
+        dd.backends.dataframe_creation_dispatch._backends, "test", Backend()
+    )
+    pdf = pd.DataFrame({"x": [1]})
+    assert dd.from_pandas(pdf, backend="test") == "dataframe-backend"
+    with dask.config.set({"dataframe.backend": "test"}):
+        assert dd.from_pandas(pdf) == "dataframe-backend"
