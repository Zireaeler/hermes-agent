+++ b/dask/backends.py
@@ -0,0 +1,64 @@
+from __future__ import annotations
+
+from functools import partial
+
+from dask import config
+from dask.compatibility import entry_points
+
+
+class CreationDispatch:
+    """Dispatch collection creation and conversion to registered backends."""
+
+    def __init__(self, module_name, default, entrypoint_root, name=None):
+        self._module_name = module_name
+        self._default = default
+        self._entrypoint_root = entrypoint_root
+        self._lookup = {}
+        self._entrypoints_loaded = False
+        if name:
+            self.__name__ = name
+
+    @property
+    def backend(self):
+        return config.get(f"{self._module_name}.backend", self._default)
+
+    def register_backend(self, name, backend):
+        self._lookup[name] = backend
+
+    def _load_entrypoints(self):
+        if self._entrypoints_loaded:
+            return
+        self._entrypoints_loaded = True
+        for entrypoint in entry_points(group=self._entrypoint_root):
+            backend = entrypoint.load()
+            if isinstance(backend, type):
+                backend = backend()
+            self.register_backend(entrypoint.name, backend)
+
+    def dispatch(self, backend=None):
+        backend = backend or self.backend
+        if backend not in self._lookup:
+            self._load_entrypoints()
+        try:
+            return self._lookup[backend]
+        except KeyError as e:
+            available = ", ".join(sorted(self._lookup)) or "none"
+            raise ValueError(
+                f"No backend dispatch registered for {backend!r}. "
+                f"Registered backends: {available}"
+            ) from e
+
+    def __getattr__(self, method):
+        if method.startswith("_"):
+            raise AttributeError(method)
+        return partial(self._dispatch, method)
+
+    def _dispatch(self, method, *args, backend=None, **kwargs):
+        entrypoint = self.dispatch(backend)
+        try:
+            func = getattr(entrypoint, method)
+        except AttributeError as e:
+            raise ValueError(
+                f"Backend {backend or self.backend!r} does not implement {method!r}"
+            ) from e
+        return func(*args, **kwargs)
