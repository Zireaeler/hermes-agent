@@ -0,0 +1,66 @@
+import pytest
+import pandas as pd
+
+import dask
+from dask.backends import CreationDispatch
+
+
+class Backend:
+    def create(self, value):
+        return value + 1
+
+
+def test_creation_dispatch_explicit_and_config():
+    dispatch = CreationDispatch("test", "default", "dask.test.backends")
+    dispatch.register_backend("default", Backend())
+    dispatch.register_backend("other", Backend())
+
+    assert dispatch.create(1) == 2
+    assert dispatch.create(1, backend="other") == 2
+    with pytest.raises(ValueError, match="missing"):
+        dispatch.create(1, backend="missing")
+
+    with dask.config.set({"test.backend": "other"}):
+        assert dispatch.create(2) == 3
+
+
+def test_collection_to_default_backend():
+    import dask.array as da
+    import dask.dataframe as dd
+
+    array = da.arange(3, chunks=1)
+    frame = dd.DataFrame.from_dict({"x": [1, 2]}, npartitions=1)
+    assert array.to_backend() is array
+    assert frame.to_backend() is frame
+
+
+def test_collection_backend_registration():
+    import dask.array as da
+    import dask.dataframe as dd
+    from dask.array.backends import array_creation_dispatch
+    from dask.dataframe.backends import dataframe_creation_dispatch
+
+    class ArrayBackend:
+        @staticmethod
+        def to_backend(data, **kwargs):
+            return "array-backend", data
+
+    class DataFrameBackend:
+        @staticmethod
+        def to_backend(data, **kwargs):
+            return "dataframe-backend", data
+
+        @staticmethod
+        def from_dict(data, **kwargs):
+            return "from-dict", data
+
+    array_creation_dispatch.register_backend("test", ArrayBackend())
+    dataframe_creation_dispatch.register_backend("test", DataFrameBackend())
+
+    array = da.arange(2, chunks=1)
+    frame = dd.from_pandas(pd.DataFrame({"x": [1]}), npartitions=1)
+    assert array.to_backend("test") == ("array-backend", array)
+    assert frame.to_backend("test") == ("dataframe-backend", frame)
+    assert dd.DataFrame.from_dict(
+        {"x": [1]}, npartitions=1, backend="test"
+    ) == ("from-dict", {"x": [1]})
