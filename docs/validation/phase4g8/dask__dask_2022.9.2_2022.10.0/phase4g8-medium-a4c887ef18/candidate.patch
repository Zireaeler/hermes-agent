@@ -0,0 +1,66 @@
+import pickle
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+
+import numpy as np
+import pandas as pd
+import pytest
+
+import dask.array as da
+import dask.dataframe as dd
+from dask.dataframe.utils import assert_eq
+from dask.delayed import delayed
+from dask.utils import Dispatch
+
+
+@pytest.mark.parametrize("use_mask", [False, True])
+def test_array_setitem_nan_into_integer_raises(use_mask):
+    array = da.ones(4, chunks=2, dtype=int)
+    with pytest.raises(ValueError, match="cannot convert float NaN to integer"):
+        array[array > 0 if use_mask else 0] = np.nan
+
+
+def test_delayed_reflected_binops_are_pickleable():
+    value = delayed(2)
+    for result, expected in [(1 + value, 3), (10 - value, 8), (10 / value, 5)]:
+        result = pickle.loads(pickle.dumps(result))
+        assert result.compute() == expected
+
+
+def test_lazy_dispatch_registration_is_thread_safe():
+    dispatch = Dispatch()
+    barrier = Barrier(2)
+
+    class Lazy:
+        pass
+
+    Lazy.__module__ = "test_lazy.module"
+
+    @dispatch.register_lazy("test_lazy")
+    def register():
+        barrier.wait()
+        dispatch.register(Lazy, lambda value: value)
+
+    with ThreadPoolExecutor(2) as executor:
+        futures = [executor.submit(dispatch, Lazy()) for _ in range(2)]
+    assert all(isinstance(future.result(), Lazy) for future in futures)
+
+
+def test_groupby_median_and_aggregate():
+    frame = pd.DataFrame(
+        {"key": ["a", "b", "a", "b", "a"], "x": [1, 4, 9, 2, 5]}
+    )
+    dframe = dd.from_pandas(frame, npartitions=3)
+    assert_eq(dframe.groupby("key").median(), frame.groupby("key").median())
+    assert_eq(dframe.groupby("key").x.median(), frame.groupby("key").x.median())
+    assert_eq(dframe.groupby("key").agg("median"), frame.groupby("key").agg("median"))
+
+
+def test_csv_projection_can_drop_or_select_path_column(tmp_path):
+    path = tmp_path / "data.csv"
+    pd.DataFrame({"x": [1, 2], "y": [3, 4]}).to_csv(path, index=False)
+    frame = dd.read_csv(str(path), include_path_column=True)
+    assert_eq(frame[["x"]], pd.DataFrame({"x": [1, 2]}), check_index=False)
+    result = frame[["path"]].compute()
+    assert list(result.columns) == ["path"]
+    assert result.path.str.endswith("data.csv").all()
