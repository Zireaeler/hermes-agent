+++ b/dask/cli.py
@@ -0,0 +1,69 @@
+from __future__ import annotations
+
+import warnings
+import webbrowser
+
+import click
+import yaml
+
+from dask import __version__, config as dask_config
+from dask.compatibility import entry_points
+from dask.utils import show_versions
+
+
+@click.group(context_settings={"help_option_names": ["-h", "--help"]})
+@click.version_option(version=__version__)
+def cli():
+    """Dask command line interface."""
+
+
+@cli.command()
+@click.argument("key", required=False)
+def config(key=None):
+    """Print Dask configuration, optionally restricted to KEY."""
+    value = dask_config.get(key) if key else dask_config.config
+    click.echo(yaml.safe_dump(value, default_flow_style=False, sort_keys=False).rstrip())
+
+
+@cli.command()
+def info():
+    """Print versions useful for bug reports."""
+    show_versions()
+
+
+@cli.command()
+def docs():
+    """Open the Dask documentation in a web browser."""
+    webbrowser.open("https://docs.dask.org")
+
+
+def register_command(command):
+    """Register an external Click command with the Dask CLI."""
+    if command.name in cli.commands:
+        warnings.warn(
+            f"While registering the command with name {command.name!r}, an existing "
+            "command or group was overwritten.",
+            UserWarning,
+        )
+    cli.add_command(command)
+
+
+def _register_entrypoints():
+    for entrypoint in entry_points(group="dask_cli"):
+        try:
+            command = entrypoint.load()
+            register_command(command)
+        except Exception as e:
+            warnings.warn(
+                f"Failed to load Dask CLI command {entrypoint.name!r}: {e}",
+                UserWarning,
+            )
+
+
+def run_cli():
+    _register_entrypoints()
+    cli()
+
+
+if __name__ == "__main__":  # pragma: no cover
+    run_cli()
