new file mode 100644
index 0000000..a35002d
--- /dev/null
+++ b/dask/backends.py
@@ -0,0 +1,60 @@
+"""Shared support for configurable collection backends."""
+
+from __future__ import annotations
+
+from dask import config
+from dask.compatibility import entry_points
+
+
+class DaskBackendEntrypoint:
+    """Base class for backend entrypoints."""
+
+    @classmethod
+    def to_backend(cls, data, **kwargs):
+        raise NotImplementedError
+
+
+class CreationDispatch:
+    """Dispatch collection-creation methods to a configured backend."""
+
+    def __init__(self, module_name, default, entrypoint_root=None):
+        self._module_name = module_name
+        self._default = default
+        self._entrypoint_root = entrypoint_root or f"dask.{module_name}.backends"
+        self._lookup = {}
+        self._entrypoints_loaded = False
+
+    def register_backend(self, name, backend=None):
+        def register(backend):
+            self._lookup[name] = backend
+            return backend
+
+        return register(backend) if backend is not None else register
+
+    def _load_entrypoints(self):
+        if self._entrypoints_loaded:
+            return
+        self._entrypoints_loaded = True
+        for entrypoint in entry_points(group=self._entrypoint_root):
+            self.register_backend(entrypoint.name, entrypoint.load())
+
+    def dispatch(self, backend=None):
+        backend = backend or config.get(
+            f"{self._module_name}.backend", self._default
+        )
+        if backend not in self._lookup:
+            self._load_entrypoints()
+        try:
+            return self._lookup[backend]
+        except KeyError as err:
+            raise ValueError(
+                f"No backend dispatch registered for {backend!r}"
+            ) from err
+
+    def __getattr__(self, method):
+        def dispatch(*args, **kwargs):
+            backend = kwargs.pop("backend", None)
+            entrypoint = self.dispatch(backend)
+            return getattr(entrypoint, method)(*args, **kwargs)
+
+        return dispatch
diff --git a/dask/cli.py b/dask/cli.py
new file mode 100644
index 0000000..ae0962c
--- /dev/null
+++ b/dask/cli.py
@@ -0,0 +1,69 @@
+"""The extensible command-line interface for Dask."""
+
+import warnings
+
+import click
+
+import dask
+from dask.compatibility import entry_points
+from dask.utils import show_versions
+
+
+@click.group(context_settings={"help_option_names": ["-h", "--help"]})
+@click.version_option(version=dask.__version__)
+def cli():
+    """Dask command line interface."""
+
+
+@cli.group()
+def info():
+    """Information about your Dask installation."""
+
+
+@info.command()
+def versions():
+    """Print versions of Dask and its dependencies."""
+    show_versions()
+
+
+def _register_command_ep(interface, entry_point):
+    """Register one command exposed through the ``dask_cli`` entry-point group."""
+    try:
+        command = entry_point.load()
+    except Exception as err:
+        warnings.warn(
+            f"While registering the command with name {entry_point.name!r}, "
+            f"an exception occurred: {err}",
+            UserWarning,
+        )
+        return
+
+    if not isinstance(command, click.Command):
+        warnings.warn(
+            "Dask CLI entry points must be instances of click.Command or "
+            f"click.Group, not {type(command)!r}.",
+            UserWarning,
+        )
+    elif command.name in interface.commands:
+        warnings.warn(
+            f"While registering the command with name {entry_point.name!r}, "
+            f"the command {command.name!r} is already registered and will not "
+            "be overwritten.",
+            UserWarning,
+        )
+    else:
+        interface.add_command(command)
+
+
+def run_cli():
+    """Load third-party commands and run the Dask CLI."""
+    for entry_point in entry_points(group="dask_cli"):
+        _register_command_ep(cli, entry_point)
+    cli()
+
+
+main = run_cli
+
