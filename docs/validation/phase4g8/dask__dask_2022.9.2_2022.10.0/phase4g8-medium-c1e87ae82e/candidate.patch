+import json
+
+import click
+import pytest
+from click.testing import CliRunner
+
+from dask.cli import _register_command_ep, cli
+
+
+class EntryPoint:
+    name = "hello"
+
+    def load(self):
+        @click.command()
+        def hello():
+            click.echo("hello")
+
+        return hello
+
+
+def test_cli_version():
+    result = CliRunner().invoke(cli, ["--version"])
+    assert result.exit_code == 0
+
+
+def test_cli_entrypoint(monkeypatch):
+    _register_command_ep(cli, EntryPoint())
+    result = CliRunner().invoke(cli, ["hello"])
+    assert result.exit_code == 0
+    assert result.output == "hello\n"
+
+
+def test_info_versions():
+    result = CliRunner().invoke(cli, ["info", "versions"])
+    assert result.exit_code == 0
+    versions = json.loads(result.output)
+    assert "dask" in versions
+    assert versions["distributed"] is None
+
+
+def test_register_command_ep_warns_for_invalid_command():
+    entry_point = EntryPoint()
+    entry_point.load = lambda: object()
+    with pytest.warns(UserWarning, match="must be instances of"):
+        _register_command_ep(click.Group(), entry_point)
+
+
+def test_repeated_name_registration_warns():
+    interface = click.Group()
+    _register_command_ep(interface, EntryPoint())
+    with pytest.warns(UserWarning, match="While registering the command with name"):
+        _register_command_ep(interface, EntryPoint())
